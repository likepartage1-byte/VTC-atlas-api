\u0644\u0634\u062e\u0635\u064a\u0629 \u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u062d\u0627\u0644\u064a\u064b\u0627.',profile_update_rejected_notice:'\u062a\u0645 \u0631\u0641\u0636 \u0637\u0644\u0628 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0633\u0627\u0628\u0642: ',profile_update_submitted:'\u062a\u0645 \u062a\u0642\u062f\u064a\u0645 \u0637\u0644\u0628 \u062a\u0639\u062f\u064a\u0644 \u0645\u0644\u0641\u0643 \u0627\u0644\u0634\u062e\u0635\u064a \u0628\u0646\u062c\u0627\u062d \u0648\u0647\u0648 \u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629.',manufacturer_label:'\u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0645\u0635\u0646\u0639\u0629',brand_label:'\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629',model_label:'\u0627\u0644\u0645\u0648\u062f\u064a\u0644',year_label:'\u0633\u0646\u0629 \u0627\u0644\u0635\u0646\u0639',color_label:'\u0644\u0648\u0646 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',fuel_type_label:'\u0646\u0648\u0639 \u0627\u0644\u0648\u0642\u0648\u062f',transmission_label:'\u0646\u0648\u0639 \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629',seats_label:'\u0639\u062f\u062f \u0627\u0644\u0645\u0642\u0627\u0639\u062f',plate_number_label:'\u0631\u0642\u0645 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u0633\u062c\u064a\u0644',registration_number_label:'\u0631\u0642\u0645 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',vin_label:'\u0631\u0642\u0645 \u0627\u0644\u0647\u064a\u0643\u0644 (VIN)',vin_readonly_notice:'\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0639\u062f\u064a\u0644 \u0631\u0642\u0645 \u0627\u0644\u0647\u064a\u0643\u0644 \u0644\u0623\u0633\u0628\u0627\u0628 \u0623\u0645\u0646\u064a\u0629.',vehicle_photos_section:'\u0635\u0648\u0631 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',update_photo_btn:'\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0635\u0648\u0631\u0629',save_changes_btn:'\u062d\u0641\u0638 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a',vehicle_update_pending_notice:'\u23f3 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0642\u064a\u062f \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u062d\u0627\u0644\u064a\u0627\u064b.',vehicle_update_rejected_notice:'\u274c \u062a\u0645 \u0631\u0641\u0636 \u0637\u0644\u0628 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0627\u0644\u0623\u062e\u064a\u0631: ',vehicle_already_pending_warning:'\u23f3 \u0644\u062f\u064a\u0643 \u0637\u0644\u0628 \u062a\u0639\u062f\u064a\u0644 \u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629\u060c \u064a\u0631\u062c\u0649 \u0627\u0646\u062a\u0638\u0627\u0631 \u0642\u0631\u0627\u0631 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0642\u0628\u0644 \u0625\u0631\u0633\u0627\u0644 \u0637\u0644\u0628 \u062c\u062f\u064a\u062f.',mandatory_field_error:'\u062c\u0645\u064a\u0639 \u0627\u0644\u062d\u0642\u0648\u0644 \u0627\u0644\u0625\u0644\u0632\u0627\u0645\u064a\u0629 \u064a\u062c\u0628 \u0623\u0646 \u062a\u0645\u0644\u0623.',invalid_year_error:'\u0633\u0646\u0629 \u0627\u0644\u0635\u0646\u0639 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629.',invalid_plate_error:'\u0635\u064a\u063a\u0629 \u0631\u0642\u0645 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629.',invalid_registration_error:'\u0635\u064a\u063a\u0629 \u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629.',invalid_seats_error:'\u0639\u062f\u062f \u0627\u0644\u0645\u0642\u0627\u0639\u062f \u063a\u064a\u0631 \u0635\u0627\u0644\u062d.',guide_front:'\u0636\u0639 \u0645\u0642\u062f\u0645\u0629 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0637\u0627\u0631',guide_back:'\u0636\u0639 \u0645\u0624\u062e\u0631\u0629 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0637\u0627\u0631',guide_right:'\u0636\u0639 \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u064a\u0645\u0646 \u0644\u0644\u0645\u0631\u0643\u0628\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0637\u0627\u0631',guide_left:'\u0636\u0639 \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u064a\u0633\u0631 \u0644\u0644\u0645\u0631\u0643\u0628\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0637\u0627\u0631',guide_interior:'\u0627\u0644\u062a\u0642\u0637 \u0635\u0648\u0631\u0629 \u0648\u0627\u0636\u062d\u0629 \u0644\u0644\u0635\u0627\u0644\u0648\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0644\u0644\u0645\u0631\u0643\u0628\u0629',guide_plate:'\u0636\u0639 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 \u0628\u0634\u0643\u0644 \u0623\u0641\u0642\u064a \u0648\u0648\u0627\u0636\u062d \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0637\u0627\u0631',slot_front:'\u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629',slot_back:'\u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629',slot_right:'\u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u064a\u0645\u0646',slot_left:'\u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u064a\u0633\u0631',slot_interior:'\u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629',slot_plate:'\u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u0633\u062c\u064a\u0644',vehicle_type_title:'\u0627\u062e\u062a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',vehicle_type_sub:'\u0627\u062e\u062a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0627\u0644\u062a\u064a \u0633\u062a\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u0644\u0644\u0639\u0645\u0644 \u0639\u0644\u0649 Yalla VTC.',type_car_label:'\u0633\u064a\u0627\u0631\u0629',type_car_desc:'\u0644\u0646\u0642\u0644 \u0627\u0644\u0631\u0643\u0627\u0628 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0633\u064a\u0627\u0631\u0629.',type_motorcycle_label:'\u062f\u0631\u0627\u062c\u0629 \u0646\u0627\u0631\u064a\u0629',type_motorcycle_desc:'\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0623\u0648 \u062d\u0633\u0628 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629.',confirm_change_title:'\u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',confirm_change_type_message:'\u0633\u064a\u0624\u062f\u064a \u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0625\u0644\u0649 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0637\u0644\u0628 \u0644\u0644\u0645\u0631\u0627\u062c\u0639\u0629\u060c \u0648\u0642\u062f \u064a\u062a\u0637\u0644\u0628 \u0631\u0641\u0639 \u0648\u062b\u0627\u0626\u0642 \u0648\u0635\u0648\u0631 \u062c\u062f\u064a\u062f\u0629 \u0644\u0644\u0645\u0631\u0643\u0628\u0629.',cancel_btn:'\u0625\u0644\u063a\u0627\u0621',continue_btn:'\u0645\u062a\u0627\u0628\u0639\u0629',change_type_btn:'\u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',vehicle_photo_label:'\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',grey_card_label:'\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0631\u0645\u0627\u062f\u064a\u0629 \u0644\u0644\u0645\u0631\u0643\u0628\u0629',take_photo_option:'\u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u0631\u0629',take_new_photo_option:'\u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u0631\u0629 \u062c\u062f\u064a\u062f\u0629',choose_from_device_option:'\u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0646 \u0627\u0644\u062c\u0647\u0627\u0632',choose_another_option:'\u0627\u062e\u062a\u064a\u0627\u0631 \u0635\u0648\u0631\u0629 \u0623\u062e\u0631\u0649',camera_guide_vehicle:'\u0636\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0637\u0627\u0631',camera_guide_registration:'\u0636\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0631\u0645\u0627\u062f\u064a\u0629 \u0628\u0634\u0643\u0644 \u0648\u0627\u0636\u062d \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0637\u0627\u0631',rejection_title:'\u062a\u0645 \u0631\u0641\u0636 \u0627\u0644\u0645\u0633\u062a\u0646\u062f',rejection_desc:'\u062a\u0645 \u0631\u0641\u0636 \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0645\u0631\u0643\u0628\u062a\u0643 \u0644\u0644\u0633\u0628\u0628 \u0627\u0644\u062a\u0627\u0644\u064a: {{reason}}',photo_guidelines_title:'\u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0635\u0648\u0631',illus_label:'\u0645\u062b\u0627\u0644 \u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0635\u0648\u0631\u0629 \u0644\u0645\u0631\u0643\u0628\u062a\u0643 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d \u0644\u062a\u062c\u0646\u0628 \u0627\u0644\u0631\u0641\u0636:',chk_bullet_1:'\u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0645\u0631\u0626\u064a\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0645\u0646 \u0627\u0644\u0623\u0645\u0627\u0645',chk_bullet_2:'\u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 \u0645\u0642\u0631\u0648\u0621\u0629 \u0648\u0648\u0627\u0636\u062d\u0629',chk_bullet_3:'\u0625\u0636\u0627\u0621\u0629 \u062c\u064a\u062f\u0629 \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u0638\u0644\u064a\u0644',chk_bullet_4:'\u0639\u062f\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0641\u0644\u0627\u062a\u0631 \u0623\u0648 \u0644\u0642\u0637\u0627\u062a \u0634\u0627\u0634\u0629',chk_bullet_5:'\u0639\u062f\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0635\u0648\u0631 \u0642\u062f\u064a\u0645\u0629 \u0623\u0648 \u0645\u0639\u062f\u0644\u0629',age_limit_error:'\u0639\u0645\u0631 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u063a\u064a\u0631 \u0645\u0642\u0628\u0648\u0644. \u0633\u064a\u0627\u0633\u0629 Yalla VTC \u062a\u0633\u0645\u062d \u0628\u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0630\u0627\u062a \u0627\u0644\u0640 20 \u0639\u0627\u0645\u0627\u064b \u0623\u0648 \u0623\u0642\u0644 \u0641\u0642\u0637.',validation_checking_title:'\u0641\u062d\u0635 \u062c\u0648\u062f\u0629 \u0627\u0644\u0635\u0648\u0631\u0629',validation_desc:'\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u064a \u062a\u0645 \u062a\u062d\u0645\u064a\u0644\u0647\u0627 \u062a\u0628\u062f\u0648 \u063a\u064a\u0631 \u0648\u0627\u0636\u062d\u0629 \u0623\u0648 \u0630\u0627\u062a \u0625\u0636\u0627\u0621\u0629 \u0636\u0639\u064a\u0641\u0629. \u064a\u0631\u062c\u0649 \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u0631\u0629 \u062a\u062d\u062a \u0625\u0636\u0627\u0621\u0629 \u062c\u064a\u062f\u0629 \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u0627\u0647\u062a\u0632\u0627\u0632.',under_review_title:'\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629',under_review_body:'\u062a\u0645 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u0631\u0629 \u0648\u0647\u064a \u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629. \u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u062d\u0627\u0644\u064a\u0627\u064b.',photo_lbl:'\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',retake_photo:'\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0635\u0648\u0631\u0629',approved_label:'\u0645\u0642\u0628\u0648\u0644',rejected_label:'\u0645\u0631\u0641\u0648\u0636',verification_done_title:'\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0628\u0646\u062c\u0627\u062d \ud83c\udf89',verification_done_desc:'\u0644\u0642\u062f \u062a\u0645\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0648\u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0645\u0631\u0643\u0628\u062a\u0643 \u0628\u0646\u062c\u0627\u062d.',progress_title:'\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0631\u0643\u0628\u0629',progress_detail:'\u062a\u0645 \u0625\u0643\u0645\u0627\u0644 {{completed}} \u0645\u0646 {{total}} \u0639\u0646\u0627\u0635\u0631',timeline_status_title:'\u062d\u0627\u0644\u0629 \u0637\u0644\u0628 \u0627\u0644\u062a\u062d\u0642\u0642',timeline_step_upload:'\u0631\u0641\u0639 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a',timeline_step_review:'\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629',timeline_step_approved:'\u062a\u0645\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629',timeline_step_rejected:'\u0645\u0631\u0641\u0648\u0636',timeline_step_decision:'\u0627\u0644\u0642\u0631\u0627\u0631 \u0627\u0644\u0646\u0647\u0627\u0626\u064a',success_notif:'\u0645\u0628\u0627\u0631\u0643! \u062a\u0645 \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0631\u0643\u0628\u062a\u0643 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0648\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0622\u0646 \u0628\u062f\u0621 \u062a\u0644\u0642\u064a \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0631\u0643\u0648\u0628.',grey_card_label_full:'\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0631\u0645\u0627\u062f\u064a\u0629 \u0644\u0644\u0645\u0631\u0643\u0628\u0629',file_read_error:'\u0641\u0634\u0644 \u0641\u064a \u0642\u0631\u0627\u0621\u0629 \u0645\u0644\u0641 \u0627\u0644\u0635\u0648\u0631\u0629.',upload_failed_error:'\u0641\u0634\u0644 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u0631\u0629.',capture_failed_error:'\u0641\u0634\u0644 \u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0635\u0648\u0631\u0629.',select_brand_first_warning:'\u064a\u0631\u062c\u0649 \u0627\u062e\u062a\u064a\u0627\u0631 \u0639\u0644\u0627\u0645\u0629 \u062a\u062c\u0627\u0631\u064a\u0629 \u0623\u0648\u0644\u0627\u064b.',fill_all_fields_error:'\u064a\u0631\u062c\u0649 \u0645\u0644\u0621 \u062c\u0645\u064a\u0639 \u0627\u0644\u062d\u0642\u0648\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629.',suggestion_saved_success:'\u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0645\u0642\u062a\u0631\u062d\u0643 \u0628\u0646\u062c\u0627\u062d. \u0633\u064a\u062a\u0645 \u0645\u0631\u0627\u062c\u0639\u062a\u0647 \u0642\u0631\u064a\u0628\u0627\u064b.',suggestion_save_error:'\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062d\u0641\u0638 \u0627\u0644\u0645\u0642\u062a\u0631\u062d \u0627\u0644\u062e\u0627\u0635 \u0628\u0643.',select_brand_placeholder:'\u0627\u062e\u062a\u0631 \u0639\u0644\u0627\u0645\u0629 \u062a\u062c\u0627\u0631\u064a\u0629 \u0645\u0646 \u0627\u0644\u0642\u0627\u0626\u0645\u0629...',select_model_placeholder:'\u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0648\u062f\u064a\u0644...',select_brand_title:'\u0627\u062e\u062a\u0631 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629',search_brand_placeholder:'\u0627\u0628\u062d\u062b \u0639\u0646 \u0639\u0644\u0627\u0645\u0629 \u062a\u062c\u0627\u0631\u064a\u0629...',select_model_title:'\u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0648\u062f\u064a\u0644',no_models_available:'\u0644\u0627 \u062a\u062a\u0648\u0641\u0631 \u0645\u0648\u062f\u064a\u0644\u0627\u062a \u062d\u0627\u0644\u064a\u0627\u064b.',model_not_found_suggest:'\u0627\u0644\u0645\u0648\u062f\u064a\u0644 \u063a\u064a\u0631 \u0645\u0648\u062c\u0648\u062f\u061f \u0627\u0642\u062a\u0631\u062d \u0625\u0636\u0627\u0641\u062a\u0647',brand_not_found_suggest:'\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u063a\u064a\u0631 \u0645\u0648\u062c