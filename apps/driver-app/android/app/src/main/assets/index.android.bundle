627\u0644\u062c\u0648\u0627\u0632 \u2705',expiry_label:'\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629',expiry_placeholder:'\u0627\u0636\u063a\u0637 \u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621',submit_btn:'\u062d\u0641\u0638 \u0627\u0644\u0648\u062b\u064a\u0642\u0629',submitting:'\u062c\u0627\u0631\u064d \u0627\u0644\u062d\u0641\u0638 \u0648\u0627\u0644\u0631\u0641\u0639...',err_front:'\u064a\u062c\u0628 \u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u0631\u0629 \u0627\u0644\u0648\u062c\u0647 \u0627\u0644\u0623\u0645\u0627\u0645\u064a.',err_back:'\u064a\u062c\u0628 \u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u0631\u0629 \u0627\u0644\u0648\u062c\u0647 \u0627\u0644\u062e\u0644\u0641\u064a.',err_passport:'\u064a\u062c\u0628 \u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u0631\u0629 \u0635\u0641\u062d\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0628\u0627\u0644\u062c\u0648\u0627\u0632.',err_expiry:'\u064a\u062c\u0628 \u062a\u062d\u062f\u064a\u062f \u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629.',upload_success:'\u062a\u0645 \u062d\u0641\u0638 \u0648\u062b\u064a\u0642\u0629 \u0627\u0644\u0647\u0648\u064a\u0629 \u0628\u0646\u062c\u0627\u062d!',upload_error:'\u0641\u0634\u0644 \u062d\u0641\u0638 \u0627\u0644\u0648\u062b\u064a\u0642\u0629. \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.',err_real_name_required:'\u064a\u062a\u0637\u0644\u0628 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0648\u062b\u0627\u0626\u0642 \u0625\u062f\u062e\u0627\u0644 \u0627\u0633\u0645\u0643 \u0627\u0644\u062d\u0642\u064a\u0642\u064a. \u064a\u0631\u062c\u0649 \u062a\u062d\u062f\u064a\u062b \u0627\u0633\u0645\u0643 \u0641\u064a \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0628\u062f\u0644\u0627\u064b \u0645\u064